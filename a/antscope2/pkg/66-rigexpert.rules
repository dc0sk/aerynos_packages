# RigExpert's HID-class analyzers (Stick 200/500 and the AA-N "Zero" line),
# vendor and product IDs taken from AntScope2's own
# devinfo/redeviceinfo.cpp (m_devVid/m_devPid, m_bootVid/m_bootPid) rather
# than guessed: 0483:a1de is normal operating mode, 0483:a1da is the DFU
# bootloader the firmware updater briefly re-enumerates as.
#
# Upstream's own udev rule (shipped in the antscope2 AUR package, not in
# this git tree) sets MODE="0666", world-writable. TAG+="uaccess" with mode
# 0660 is used here instead, the same choice s/sdrplay-api makes and for the
# same reason: logind grants an ACL to whoever is logged in at the seat,
# which is what a desktop user needs and nothing wider. The file is
# numbered below systemd's 73-seat-late.rules, which runs the uaccess
# builtin, so the tag lands in time to take effect.

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="a1de", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="a1da", MODE="0660", TAG+="uaccess"
